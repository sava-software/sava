# Exclude everything by default.
/*

# Explicitly include tracked files and directories.
!/.dockerignore
!/.github/
!/.gitignore
!/.release-please-manifest.json
!/arcmutate-licence.txt
!/CHANGELOG.md
!/LICENSE
!/README.md
!/assets/
!/gradle/
!/gradle.properties
!/gradlew
!/gradlew.bat
!/jmh/
!/logging.properties
!/release-please-config.json
!/sava-*/
!/settings.gradle.kts
!AGENTS.md
!AGAVE_SYNC.md
!CONVENTIONS.md
!HARDENING_NOTES.md

# Re-apply ignores within included directories.
.gradle
.kotlin
build/
gradle-app.setting
.gradletasknamecache
*.class
*.log
*.ctxt
.mtj.tmp/
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.war
*.ear
*.tar.gz
*.rar
hs_err_pid*
*.iml
.idea
out/
*.secret
.DS_Store
ignore
.keys
keys
Integ.*
integ.*

# Cargo build output for the Rust conformance-vector generators under
# sava-core/src/test/solana/. Kept here rather than in a per-crate .gitignore so the rule
# survives a branch switch: a crate-local ignore file is itself tracked, so checking out a
# branch without the crate takes the rule away and strands its build output as untracked.
target/

# arcmutate incremental-analysis state — machine local, survives clean
.pitest-history/

# atomic baseline-write temp; a kill in the write window can leave one behind
*.csv.tmp
